{
  "name": "amixos",
  "version": "0.1.38",
  "private": true,
  "workspaces": [
    "web",
    "mobile",
    "api",
    "shared"
  ],
  "scripts": {
    "dev:api": "cd api && npm run dev",
    "dev:web": "cd web && npm run dev",
    "dev:mobile": "cd mobile && npx expo start",
    "build:api": "cd api && npm run build",
    "build:web": "cd web && npm run build",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "postinstall": "node -e \"process.exit(process.env.VERCEL ? 0 : 1)\" || patch-package"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "lucide-react-native": "^0.378.0",
    "react-native": "0.74.5",
    "react-native-svg": "15.2.0"
  }
}
