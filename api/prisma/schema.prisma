generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String?
  firstName     String
  lastName      String
  phone         String?
  avatarUrl     String?
  language      String     @default("en") // "en" | "es"
  twoFactorEnabled Boolean @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  businesses    BusinessMember[]
  ownedBusinesses Business[]
  timesheets    Timesheet[]
  oauthAccounts OAuthAccount[]
}

model OAuthAccount {
  id         String   @id @default(uuid())
  provider   String   // "google" | "apple" | "facebook"
  providerId String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

// ─── Businesses ───────────────────────────────────────────────────────────────

model Business {
  id            String   @id @default(uuid())
  name          String
  serviceType   String?
  logoUrl       String?
  address       String?
  city          String?
  state         String?
  postalCode    String?
  country       String   @default("US")
  virtualNumber String?
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members       BusinessMember[]
  clients       Client[]
  invoices      Invoice[]
  timesheets    Timesheet[]
  modules       BusinessModule[]
  calendar      CalendarEvent[]
  inventory     InventoryItem[]
}

model BusinessMember {
  id         String   @id @default(uuid())
  businessId String
  userId     String
  role       String   @default("worker") // "owner" | "manager" | "worker"
  title      String?
  payType    String?  // "hourly" | "salary"
  payRate    Float?
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([businessId, userId])
}

// ─── Modules ──────────────────────────────────────────────────────────────────

model BusinessModule {
  id         String   @id @default(uuid())
  businessId String
  moduleKey  String   // "construction" | "inventory" | "voip" | "appointments" | etc.
  isActive   Boolean  @default(true)
  settings   Json?
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  activatedAt DateTime @default(now())

  @@unique([businessId, moduleKey])
}

// ─── Clients ──────────────────────────────────────────────────────────────────

model Client {
  id            String   @id @default(uuid())
  businessId    String
  firstName     String
  lastName      String
  companyName   String?
  email         String?
  mobilePhone   String?
  officePhone   String?
  website       String?
  address       String?
  city          String?
  state         String?
  postalCode    String?
  country       String?
  loyaltyStatus String   @default("good_standing") // "good_standing" | "flagged" | "vip"
  birthday      DateTime?
  notes         String?
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoices      Invoice[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Invoices ─────────────────────────────────────────────────────────────────

model Invoice {
  id           String        @id @default(uuid())
  businessId   String
  clientId     String?
  invoiceNumber String       @unique
  type         String        @default("invoice") // "invoice" | "estimate"
  status       String        @default("draft")   // "draft" | "sent" | "paid" | "overdue" | "cancelled"
  lineItems    Json          // Array of { description, qty, unitPrice, total }
  subtotal     Float
  tax          Float         @default(0)
  discount     Float         @default(0)
  total        Float
  notes        String?
  dueDate      DateTime?
  sentAt       DateTime?
  paidAt       DateTime?
  signatureUrl String?
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client       Client?       @relation(fields: [clientId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// ─── Timesheet ────────────────────────────────────────────────────────────────

model Timesheet {
  id         String    @id @default(uuid())
  businessId String
  userId     String
  clockIn    DateTime
  clockOut   DateTime?
  hoursTotal Float?
  approved   Boolean   @default(false)
  approvedBy String?
  notes      String?
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
}

// ─── Calendar ─────────────────────────────────────────────────────────────────

model CalendarEvent {
  id          String    @id @default(uuid())
  businessId  String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime?
  location    String?
  createdBy   String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model InventoryItem {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  sku         String?
  description String?
  quantity    Int      @default(0)
  lowStockAt  Int?     // Alert when qty falls below this
  unitPrice   Float?
  imageUrl    String?
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
