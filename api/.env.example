# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# Supabase (use the same values as web/mobile)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Google OAuth — used by the Contacts sync engine to refresh access tokens.
# Use the same OAuth Client that Supabase uses for "Sign in with Google".
# Get from Google Cloud Console → APIs & Services → Credentials → OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
