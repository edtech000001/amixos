<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Ami call: ongoing notification (Mute / Hang up) that keeps the mic
       allowed while the app is in the background. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application>
    <service
      android:name="expo.modules.amicall.AmiCallService"
      android:exported="false"
      android:foregroundServiceType="microphone" />
    <!-- Quick Settings tile: opens Amixos straight into an Ami call. -->
    <service
      android:name="expo.modules.amicall.AmiTileService"
      android:exported="true"
      android:icon="@drawable/ami_tile"
      android:label="Ami"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>
  </application>
</manifest>
