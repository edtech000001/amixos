{
  "expo": {
    "name": "Amixos",
    "slug": "amixos",
    "scheme": "amixos",
    "version": "0.1.21",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amixos.app",
      "icon": "./assets/icon.png",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.amixos.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F4EDE0"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAmrsisBGhkAOt4pbwzFHVB18lwO_widvc"
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Amixos usa tu ubicación para registrar dónde se realizó un trabajo cuando lo agregas."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Amixos usa la cámara para escanear el código VIN y tomar fotos del equipo."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Amixos usa el micrófono para que puedas hablar con Ami, tu asistente de negocio.",
          "speechRecognitionPermission": "Amixos usa el reconocimiento de voz para entender lo que le dices a Ami."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "183b523e-43ee-4c85-8bdd-1e1851020cab"
      }
    },
    "owner": "edvinramirez56",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/183b523e-43ee-4c85-8bdd-1e1851020cab"
    }
  }
}
